# Dockerfile
# Containerizes the bioimpedance-dx inference API.
# The model file must exist in models/ before building.

FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install poetry
RUN curl -sSL https://install.python-poetry.org | python3 -
ENV PATH="/root/.local/bin:$PATH"

# Copy dependency files first (Docker layer caching)
COPY pyproject.toml poetry.lock ./

# Install dependencies only (not the project itself yet)
RUN poetry config virtualenvs.create false \
    && poetry install --only main --no-interaction --no-ansi

# Copy project source
COPY bioimpedance_dx/ ./bioimpedance_dx/
COPY models/ ./models/

# Expose API port
EXPOSE 8000

# Start the API server
CMD ["uvicorn", "bioimpedance_dx.api.app:app", "--host", "0.0.0.0", "--port", "8000"]